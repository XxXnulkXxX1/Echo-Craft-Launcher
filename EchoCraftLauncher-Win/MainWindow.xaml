<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SwiftCraftLauncher2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Echo Craft Launcher"
        Width="900" Height="560" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource UiFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <!-- 应用标志：使用 Assets/Logo.png（ECL 六边形），圆角裁剪贴合标题栏 -->
                <Image Width="26" Height="26" Source="Assets/Logo.png"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,26,26" RadiusX="6" RadiusY="6" />
                    </Image.Clip>
                </Image>
                <TextBlock Text="Echo Craft Launcher" Foreground="{DynamicResource TextBrush}"
                           FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="1.0.0" Foreground="{DynamicResource SubTextBrush}" FontSize="11"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="—"
                        Click="MinButton_Click" FontFamily="Segoe UI" FontSize="12" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="□"
                        Click="MaxButton_Click" FontFamily="Segoe UI" FontSize="12" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="✕"
                        Click="CloseButton_Click" FontFamily="Segoe UI" FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- 主体：流动背景 + 左侧页签 + 内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 动态背景：三个缓慢漂移的色团，只做视觉氛围，不接收鼠标事件 -->
            <Canvas x:Name="FlowLayer" Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False"
                    Panel.ZIndex="-1">
                <Ellipse x:Name="Blob1" Width="520" Height="520" Canvas.Left="-140" Canvas.Top="-160" Opacity="0.28">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob1Move" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Blob2" Width="420" Height="420" Canvas.Left="640" Canvas.Top="260" Opacity="0.22">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource AccentDeepColor}" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob2Move" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Blob3" Width="300" Height="300" Canvas.Left="180" Canvas.Top="420" Opacity="0.18">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob3Move" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <Border Grid.Column="0" Background="{DynamicResource NavPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="4,12,4,0">
                        <RadioButton x:Name="NavLaunch" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="launch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="启动" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDownload" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="download">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↓" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="下载" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMulti" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="multi">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◎" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="联机" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="appearance">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◐" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="外观" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="设置" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMore" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="more">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⋯" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="更多" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="16,0,16,14">
                        <TextBlock Text="XxXnulkXxX" Style="{StaticResource BodyText}" FontSize="12" />
                        <TextBlock Text="非官方 · 基于 PCL2 模块结构独立实现" Style="{StaticResource SubLabel}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="Host" Grid.Column="1" Margin="14,8,14,14" />
        </Grid>
    </Grid>
</Window>

