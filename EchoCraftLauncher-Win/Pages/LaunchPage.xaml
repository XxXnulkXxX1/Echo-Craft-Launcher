<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SwiftCraftLauncher2.Pages.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左栏：实例 + 账号 -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="游戏实例" Style="{StaticResource SubLabel}" />

                    <ListBox x:Name="InstanceList" Grid.Row="1" Margin="0,8" Style="{StaticResource PlainList}"
                             SelectionChanged="InstanceList_SelectionChanged"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                                               FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SubTitle}" Style="{StaticResource SubLabel}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="新建实例" Style="{StaticResource GhostButton}" Click="NewInstance_Click" />
                        <Button Content="删除" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Click="DeleteInstance_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="账号" Style="{StaticResource SubLabel}" />
                    <TextBlock x:Name="AccountName" Text="未登录" Foreground="{DynamicResource TextBrush}"
                               FontSize="16" FontWeight="SemiBold" Margin="0,8,0,2" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AccountKind" Text="离线模式" Style="{StaticResource SubLabel}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="正版登录" Style="{StaticResource GhostButton}" Click="MsLogin_Click" />
                        <Button Content="离线登录" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Click="OfflineLogin_Click" />
                        <Button Content="退出" Style="{StaticResource GhostButton}" Margin="8,6,0,0"
                                Click="SignOut_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 右栏：启动 -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="VersionTitle" Text="尚未选择实例" Foreground="{DynamicResource TextBrush}"
                               FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="VersionSub" Text="点击左侧「新建实例」开始" Style="{StaticResource SubLabel}"
                               Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <Button x:Name="StartButton" Grid.Row="1" Content="启动游戏" Style="{StaticResource PrimaryButton}"
                        Height="58" FontSize="18" Margin="0,18,0,0" Click="Start_Click" />

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="Bar" Grid.Column="0" Style="{StaticResource ThinProgress}"
                                 VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="就绪" Style="{StaticResource SubLabel}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="启动日志" Style="{StaticResource SubLabel}" Margin="0,0,0,6" />
                    <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource ReadonlyBox}"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="#FF1B1C20" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

