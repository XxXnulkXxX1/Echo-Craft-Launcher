<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SwiftCraftLauncher2.Pages.MorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Width="44" Height="44" Source="Assets/Logo.png"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,44,44" RadiusX="10" RadiusY="10" />
                        </Image.Clip>
                    </Image>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Echo Craft Launcher" Foreground="{DynamicResource TextBrush}"
                                   FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="版本 1.0.0 · Windows 版" Style="{StaticResource SubLabel}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="开发者" Style="{StaticResource SubLabel}" Margin="0,16,0,4" />
                <TextBlock Text="XxXnulkXxX" Foreground="{DynamicResource TextBrush}" FontSize="14" />

                <TextBlock Style="{StaticResource SubLabel}" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="22"
                           Text="独立实现的 Minecraft: Java Edition 启动器。参考了 PCL2 的界面结构与启动流程设计，代码全部重写，不包含 PCL2 源码。" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Click="OpenRoot_Click" />
                    <Button Content="打开日志目录" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="OpenLogs_Click" />
                </StackPanel>
                <Button Content="访问 Minecraft 官网" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                        HorizontalAlignment="Left" Click="OpenSite_Click" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="致谢与许可" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="23"
                           Text="界面与交互参考了 Plain Craft Launcher 2（PCL2），原作者：龙腾猫跃。PCL2 采用《PCL 分发有限许可》，本项目为非官方独立实现，未复制其代码，仅借鉴公开的流程设计。建议前往 PCL2 项目主页支持原作者。" />
                <Button Content="打开 PCL2 项目主页" Style="{StaticResource GhostButton}" Margin="0,12,0,0"
                        HorizontalAlignment="Left" Click="OpenPcl_Click" />
                <TextBlock Style="{StaticResource SubLabel}" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="21"
                           Text="请支持正版：Minecraft: Java Edition 需在官网购买后使用微软账号登录。启动器内的「正版登录」走微软官方 OAuth 与 Minecraft Services 校验，不会保存你的微软密码。" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


