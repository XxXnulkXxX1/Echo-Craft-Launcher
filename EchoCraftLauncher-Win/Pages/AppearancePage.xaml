<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SwiftCraftLauncher2.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,10">

            <TextBlock Text="外观" Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="调整主题、主色与动态效果，修改会立即生效并自动保存。" Style="{StaticResource SubLabel}"
                       Margin="0,4,0,14" />

            <!-- 主题模式 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="主题模式" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                    <TextBlock Text="深色适合夜间，浅色在明亮环境下更清晰。" Style="{StaticResource SubLabel}" Margin="0,3,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeDarkRadio" Style="{StaticResource Segment}" GroupName="Theme"
                                     Content="深色" Tag="dark" Margin="0,0,8,0" Checked="Theme_Click" />
                        <RadioButton x:Name="ThemeLightRadio" Style="{StaticResource Segment}" GroupName="Theme"
                                     Content="浅色" Tag="light" Checked="Theme_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 主色 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="主色" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                    <TextBlock Text="影响按钮、选中态、进度条与流动背景。" Style="{StaticResource SubLabel}" Margin="0,3,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <Border x:Name="SwBlue" Tag="blue" Width="42" Height="42" CornerRadius="10"
                                    Background="#3C9DF0" Cursor="Hand" BorderThickness="2"
                                    BorderBrush="Transparent" MouseLeftButtonUp="Accent_Click" />
                            <TextBlock Text="星蓝" Style="{StaticResource SubLabel}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <Border x:Name="SwPurple" Tag="purple" Width="42" Height="42" CornerRadius="10"
                                    Background="#9B6BFF" Cursor="Hand" BorderThickness="2"
                                    BorderBrush="Transparent" MouseLeftButtonUp="Accent_Click" />
                            <TextBlock Text="幻紫" Style="{StaticResource SubLabel}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <Border x:Name="SwGreen" Tag="green" Width="42" Height="42" CornerRadius="10"
                                    Background="#2FBE8A" Cursor="Hand" BorderThickness="2"
                                    BorderBrush="Transparent" MouseLeftButtonUp="Accent_Click" />
                            <TextBlock Text="苔绿" Style="{StaticResource SubLabel}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <Border x:Name="SwOrange" Tag="orange" Width="42" Height="42" CornerRadius="10"
                                    Background="#F28B42" Cursor="Hand" BorderThickness="2"
                                    BorderBrush="Transparent" MouseLeftButtonUp="Accent_Click" />
                            <TextBlock Text="熔橙" Style="{StaticResource SubLabel}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <Border x:Name="SwPink" Tag="pink" Width="42" Height="42" CornerRadius="10"
                                    Background="#F06292" Cursor="Hand" BorderThickness="2"
                                    BorderBrush="Transparent" MouseLeftButtonUp="Accent_Click" />
                            <TextBlock Text="樱粉" Style="{StaticResource SubLabel}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 动态效果 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="动态效果" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                    <TextBlock Text="关闭可降低低配设备的渲染开销。" Style="{StaticResource SubLabel}" Margin="0,3,0,10" />
                    <CheckBox x:Name="FlowCheck" Content="流动背景（缓慢漂移的色团）" Foreground="{DynamicResource TextBrush}"
                              FontSize="13" Margin="0,0,0,8" Checked="Effect_Changed" Unchecked="Effect_Changed" />
                    <CheckBox x:Name="SpringCheck" Content="弹簧动效（切页与按钮回弹）" Foreground="{DynamicResource TextBrush}"
                              FontSize="13" Checked="Effect_Changed" Unchecked="Effect_Changed" />
                </StackPanel>
            </Border>

            <!-- 弹窗预览 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="弹窗预览" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                    <TextBlock Text="所有提示、确认与错误都使用与应用同色系的自定义弹窗，不再出现白色系统对话框。"
                               Style="{StaticResource SubLabel}" Margin="0,3,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="预览提示弹窗" Style="{StaticResource GhostButton}" Click="PreviewInfo_Click" Margin="0,0,10,0" />
                        <Button Content="预览警告弹窗" Style="{StaticResource GhostButton}" Click="PreviewWarn_Click" Margin="0,0,10,0" />
                        <Button Content="恢复默认外观" Style="{StaticResource GhostButton}" Click="Reset_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

