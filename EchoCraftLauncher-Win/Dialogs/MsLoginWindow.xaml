<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SwiftCraftLauncher2.Dialogs.MsLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="微软正版登录" Width="760" Height="660" WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow" Background="{DynamicResource PanelBrush}" FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="使用微软账号登录（Minecraft 正版）" Foreground="{DynamicResource TextBrush}"
                       FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Text="正在加载登录页…" Style="{StaticResource SubLabel}" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#FF1B1C20" CornerRadius="8" ClipToBounds="True">
            <wv2:WebView2 x:Name="Browser" />
        </Border>

        <StackPanel Grid.Row="2" Margin="2,10,2,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="在浏览器中打开登录页" Style="{StaticResource GhostButton}" Click="OpenBrowser_Click" />
                <Button Content="关闭" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Cancel_Click" />
            </StackPanel>
            <TextBlock Text="内嵌页面无法登录时：在浏览器完成登录，把跳转后的完整地址粘贴到下面，点「完成登录」。"
                       Style="{StaticResource SubLabel}" Margin="0,8,0,4" TextWrapping="Wrap" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CallbackBox" Grid.Column="0" Style="{StaticResource Input}" Height="32" />
                <Button Grid.Column="1" Content="完成登录" Style="{StaticResource PrimaryButton}" Width="96"
                        Margin="8,0,0,0" Height="32" Click="Manual_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>

