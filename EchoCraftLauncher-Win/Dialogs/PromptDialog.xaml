<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SwiftCraftLauncher2.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="ToolWindow" Background="{DynamicResource PanelBrush}"
        FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="HintText" Style="{StaticResource SubLabel}" Margin="0,6,0,10" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" Style="{StaticResource Input}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
            <Button Content="确定" Style="{StaticResource PrimaryButton}" Width="84" Margin="10,0,0,0" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>

