<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SwiftCraftLauncher2.Dialogs.CreateInstanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建实例" Width="520" Height="540" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="ToolWindow" Background="{DynamicResource PanelBrush}"
        FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="新建游戏实例" Foreground="{DynamicResource TextBrush}"
                   FontSize="18" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="实例名" Style="{StaticResource SubLabel}" Margin="0,14,0,6" />
        <TextBox x:Name="NameBox" Grid.Row="2" Style="{StaticResource Input}" Text="新的世界" />
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="选择游戏版本" Style="{StaticResource SubLabel}" />
            <CheckBox x:Name="ReleaseOnly" Grid.Row="0" Grid.Column="1" Content="仅正式版" IsChecked="True"
                      Foreground="{DynamicResource SubTextBrush}" FontSize="12" Checked="Filter_Changed"
                      Unchecked="Filter_Changed" VerticalAlignment="Center" />
            <TextBox x:Name="SearchBox" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Input}"
                     Margin="0,6,0,8" TextChanged="SearchBox_TextChanged" />
            <ListBox x:Name="VersionList" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource PlainList}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Id}" Foreground="{DynamicResource TextBrush}" FontSize="13" />
                            <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource SubLabel}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="加载器" Style="{StaticResource SubLabel}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <RadioButton x:Name="LoaderNone" Content="原版" IsChecked="True"
                             Foreground="{DynamicResource TextBrush}" GroupName="Loader" />
                <RadioButton x:Name="LoaderFabric" Content="Fabric" Margin="18,0,0,0"
                             Foreground="{DynamicResource TextBrush}" GroupName="Loader" />
                <RadioButton x:Name="LoaderQuilt" Content="Quilt" Margin="18,0,0,0"
                             Foreground="{DynamicResource TextBrush}" GroupName="Loader" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Hint" Grid.Column="0" Text="首次启动会自动下载游戏文件" Style="{StaticResource SubLabel}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="创建" Style="{StaticResource PrimaryButton}" Width="92"
                        Margin="10,0,0,0" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

